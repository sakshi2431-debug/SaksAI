# Public chat: low-privilege key only. Configure RLS and RPC grants before enabling search.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SEARCH_ENABLED=false
# A legacy anon key is supported as SUPABASE_ANON_KEY during migration.
# Cloudflare Worker only:
LLM_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant
# Keep administrative indexing credentials in a separate, untracked local environment.
